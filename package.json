{
  "name": "inclusive-campus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test tests/security.test.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:workflows": "node tests/workflows.mjs",
    "test:a11y": "node tests/a11y.mjs",
    "test:ui": "npm run test:smoke && npm run test:workflows && npm run test:controls && npm run test:a11y && npm run test:matrix",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run",
    "test:security": "node --test tests/security.test.mjs",
    "test:matrix": "node tests/audit-matrix.mjs",
    "test:performance": "node tests/performance.mjs",
    "test:check": "npm run lint && npm run test:unit && npm run test:security && npm run build",
    "test:controls": "node tests/controls.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.454.0",
    "mongoose": "^8.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^2.13.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@sparticuz/chromium": "^153.0.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "lighthouse": "^13.6.0",
    "mongodb-memory-server": "^11.4.0",
    "postcss": "^8.4.47",
    "supertest": "^7.3.2",
    "tailwindcss": "^3.4.14",
